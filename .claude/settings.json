{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/coverage/**)",
      "Read(**/.turbo/**)",
      "Read(**/drizzle/meta/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check.mjs\"" }
        ]
      }
    ]
  }
}
