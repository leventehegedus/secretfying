{
  "name": "flight-deal-watcher",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dup": "jscpd .",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @fdw/api db:migrate",
    "db:seed": "pnpm --filter @fdw/api db:seed",
    "backfill": "pnpm --filter @fdw/api backfill"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
