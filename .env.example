# Turso/libSQL URL; local file by default, libsql://... in production
TURSO_DATABASE_URL=file:./data/fdw.db
# Turso auth token (required for libsql:// URLs)
TURSO_AUTH_TOKEN=
# "true" uses fixture data only and refuses all network provider calls
DRY_RUN=false
# IANA timezone used for quota day/month boundaries
TZ_SCHEDULE=Europe/Budapest
# Comma list of discovery providers (travelpayouts, serpapi, fixture)
DISCOVERY_PROVIDERS=travelpayouts
# Comma list of verification providers, in fallback order
VERIFY_PROVIDERS=serpapi
# Travelpayouts API token
TRAVELPAYOUTS_TOKEN=
# Travelpayouts data market (results differ per market)
TRAVELPAYOUTS_MARKET=hu
# Minimum delay between Travelpayouts requests in milliseconds
TRAVELPAYOUTS_MIN_INTERVAL_MS=1000
# SerpApi key
SERPAPI_KEY=
# SerpApi daily call cap (0 disables)
QUOTA_SERPAPI_DAILY=15
# SerpApi monthly call cap (0 disables)
QUOTA_SERPAPI_MONTHLY=200
# Travelpayouts daily call cap (0 disables)
QUOTA_TRAVELPAYOUTS_DAILY=500
# Travelpayouts monthly call cap (0 disables)
QUOTA_TRAVELPAYOUTS_MONTHLY=10000
# Maximum discovery calls in one run
MAX_DISCOVERY_CALLS_PER_RUN=60
# Telegram bot token for notifications
TELEGRAM_BOT_TOKEN=
# Telegram chat id receiving notifications
TELEGRAM_CHAT_ID=
# Bearer token required for mutating API routes (open if empty)
API_TOKEN=
# Bearer secret Vercel Cron sends to /api/cron/run
CRON_SECRET=
# HTTP port for local listen
PORT=3000
# pino log level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
# Set by Vercel automatically; on production, POST/PUT/DELETE return 503 unless API_TOKEN is set.
# VERCEL_ENV=
